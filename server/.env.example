# Ocean Explorer - Backend Configuration
# Copy this file to .env and adjust values for your environment

# Server Port
PORT=3001

# Node Environment ('development' | 'production')
NODE_ENV=development

# Allowed Frontend Origin for CORS and Cookie transmission
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-address>/ocean-explorer?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_atlas_connection_string_here

# JWT Authentication Secret Key (replace with a long, cryptographically secure random string in production)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Specimen Image Generation Provider ('none' | 'openai' | 'pollinations')
# Default 'none' serves curated, verified high-resolution scientific assets
IMAGE_PROVIDER=none
